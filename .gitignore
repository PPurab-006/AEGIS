# Local data cache pulled from the source VO_Research repo — never commit.
# This is a working cache, re-fetchable any time via 01_fetch_data.py.
# Committing it would duplicate R1's data and break the provenance chain
# (this repo's git history should never be the source of truth for the
# raw telemetry — VO_Research is).
data/raw/

# Ignore large intermediate frame-level feature and labeled tables (>2MB each)
data/processed/*.csv
!data/processed/expanded_flight_manifest.csv
!data/processed/expanded_flight_split.csv
!data/processed/flight_manifest.csv
!data/processed/flight_split.csv
!data/processed/live_ros2_predictions.csv
!data/processed/sweep_flight_log.csv

# Scratch and temporary scripts
scratch/

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
